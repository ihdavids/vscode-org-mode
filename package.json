{
    "name": "iorg",
    "displayName": "IOrg",
    "description": "Emacs Org mode support for VSCode with service hooks",
    "keywords": [
        "org",
        "orgmode",
        "org-mode",
        "emacs",
        "notes",
        "markdown",
        "todo",
        "task",
        "planning"
    ],
    "version": "2.0.0-SNAPSHOT",
    "publisher": "iorg",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "https://github.com/vscode-org-mode/vscode-org-mode"
    },
    "icon": "images/logo2.png",
    "engines": {
        "vscode": "^1.62.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:org",
        "onCommand:org.showAgenda",
        "onCommand:org.showGantt",
        "onCommand:org.showMindMap",
        "onCommand:org.showWeb",
        "onCommand:org.connectToOrgs",
        "onCommand:org.showDayPageToday"
    ],
    "main": "./out/src/extension",
    "contributes": {
        "commands": [
            {
                "command": "org.insertProjectTag",
                "title": "Org: Tag Project"
            },
            {
                "command": "org.insertWorkTag",
