                "title": "Org: Italic"
            },
            {
                "command": "org.underline",
                "title": "Org: Underline"
            },
            {
                "command": "org.code",
                "title": "Org: Code"
            },
            {
                "command": "org.verbose",
                "title": "Org: Verbose"
            },
            {
                "command": "org.literal",
                "title": "Org: Literal"
            },
            {
                "command": "org.butterfly",
                "title": "Org: Butterfly"
            },
            {
                "command": "org.recalcAllCheckboxSummaries",
                "title": "Org: Recalc All Checkbox"
            },
            {
                "command": "org.recalcCheckboxSummary",
                "title": "Org: Recalc Checkbox Summary"
            },
            {
                "command": "org.toggleCheckbox",
                "title": "Org: Toggle Checkbox"
            },
            {
                "command": "org.insertCheckboxSummary",
                "title": "Org: Insert Checkbox Summary"
            },
            {
                "command": "org.insertCheckbox",
                "title": "Org: Insert Checkbox"
            },
            {
                "command": "org.insertPropertyDrawer",
                "title": "Org: Insert Property Drawer"
            },
            {
                "command": "org.insertLogbookDrawer",
                "title": "Org: Insert Logbook Drawer"
            },
            {
                "command": "org.insertProperty",
                "title": "Org: Insert Property"
            },
            {
                "command": "org.updateEffortProperty",
                "title": "Org: Update Effort Property"
            },
            {
                "command": "org.reformat",
                "title": "Org: Reformat"
            },
            {
                "command": "org.refile",
                "title": "Org: ReFile"
            },
            {
                "command": "org.archive",
                "title": "Org: Archive"
            },
            {
                "command": "org.setMarker",
                "title": "Org: Set Marker"
            },
            {
                "command": "org.jumpToMarker",
                "title": "Org: Jump To Marker"
            },
            {
                "command": "org.createJira",
                "title": "Org: Create Jira"
            },
            {
                "command": "org.execBlock",
                "title": "Org: Execute Block"
            },
            {
                "command": "org.enable",
                "title": "Org: Text Table Enable"
            },
            {
                "command": "org.formatUnderCursor",
                "title": "Org: Format table under cursor"
            },
            {
                "command": "org.tableModeOn",
                "title": "Org: Enter table mode"
            },
            {
                "command": "org.tableModeOff",
                "title": "Org: Exit table mode"
            },
            {
                "command": "org.gotoNextCell",
                "title": "Org: Go to next table cell"
            },
            {
                "command": "org.gotoPreviousCell",
                "title": "Org: Go to previous table cell"
            },
            {
                "command": "org.createTable",
                "title": "Org: Create table"
            },
            {
                "command": "org.clearCell",
                "title": "Org: Clear table cell"
            },
            {
                "command": "org.moveRowDown",
                "title": "Move table row down",
                "category": "Org"
            },
            {
                "command": "org.moveRowUp",
                "title": "Move table row up",
                "category": "Org"
            },
            {
                "command": "org.moveColRight",
                "title": "Move table column right",
                "category": "Org"
            },
            {
                "command": "org.moveColLeft",
                "title": "Move table column left",
                "category": "Org"
            },
            {
                "command": "org.nextRow",
                "title": "Next table row",
                "category": "Org"
            },
            {
                "command": "org.addColLeft",
                "title": "Add Table Col",
                "category": "Org"
            },
            {
                "command": "org.addRowDown",
                "title": "Add Table Row",
                "category": "Org"
            },
            {
                "command": "org.deleteRow",
                "title": "Delete Table Row",
                "category": "Org"
            },
            {
                "command": "org.deleteCol",
                "title": "Delete Table Col",
                "category": "Org"
            }

        ],
        "languages": [
            {
                "id": "org",
                "aliases": [
                    "Org",
                    "Org Markup",
                    "Org Mode"
                ],
                "extensions": [
                    ".org"
                ],
                "configuration": "./org.configuration.json"
            },
            {
                "id": "calendar",
                "extensions": [
                    ".calendar"
                ],
                "aliases": [
                    "Calendar"
                ]
            },
            {
                "id": "todolist",
                "extensions": [
                    ".todolist"
                ],
                "aliases": [
                    "TodoList"
                ]
            }
        ],
        "grammars": [
            {
                "language": "org",
                "scopeName": "source.org",
                "path": "./syntaxes/org.tmLanguage.json"
            },
            {
                "language": "calendar",
                "scopeName": "source.calendar",
                "path": "./syntaxes/calendar.tmLanguage.json"
            },
            {
                "language": "todolist",
                "scopeName": "source.todolist",
                "path": "./syntaxes/todolist.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Org Mode configuration",
            "properties": {
                "org.todoKeywords": {
                    "type": "array",
                    "default": [
                        "TODO"
                    ],
                    "description": "Specifies the types of TODO statuses available (for switching)."
                },
                "org.doneKeywords": {
                    "type": "array",
                    "default": [
                        "DONE"
                    ],
                    "description": "Specifies the types of DONE statuses available (for switching)."
                },
                "org.underlineTopHeading": {
                    "type": "boolean",
                    "default": true,
                    "description": "Top level headings get an underline."
                },
                "org.todoConfigs": {
                    "type": "object",
                    "default": {
                        "todos": {
                            "query": "",
                            "display": {
                                "filename": 15,
                                "status": 10,
                                "headline": 25,
                                "properties": {
                                    "EFFORT": 5
                                }
                            }
                        }
                    },
                    "description": "Defines TODO list views you would like to query from the orgs server and how to display them"
                },
                "org.bullets": {
                    "type": "array",
                    "default": [
                        "◉",
                        "○",
                        "◇",
                        "◆",
                        "●",
                        "•",
                        "♦"
                    ],
                    "description": "Bullets to use in pretty formatting of headings."
                },
                "org.headingFormatting": {
                    "type": "array",
                    "default": [
                        {
                            "font-size": "23px",
                            "font-weight": "bold",
                            "font-family": "\"Century Gothic\""
                        },
                        {
                            "font-size": "20px",
                            "font-weight": "bold",
                            "font-family": "\"Ink Free\""
                        },
                        {
                            "font-size": "18px",
                            "font-weight": "bold"
                        },
                        {
                            "font-size": "18px",
                            "font-style": "italic"
                        },
                        {
                            "font-size": "18px",
                            "font-style": "italic"
                        },
                        {},
                        {},
                        {}
                    ],
                    "description": "Styles setting per heading level, up to 8"
                },
                "org.tagOffset": {
                    "type": "integer",
                    "default": 65,
                    "description": "How far (characters) out should tags be indented on a headline?"
                },
                "org.gantts": {
                    "type": "object",
                    "default": {
                        "default": "HasProperty(\"EFFORT\")"
                    },
                    "description": "Named gantt heading querries"
                },
                "org.captureTemplates": {
                    "type": "object",
                    "default": {
                        "todo": {
                            "type":    "entry",
                            "snippet": "* ${1:HEADING}\n   ${2:BODY}"
                        }
                    },
                    "description": "Capture templates to use for capture types."
                },
                "org.linkColoring": {
                    "type": "string",
                    "default": "rgba(0, 128, 255, 1.0)",
                    "description": "What color should links be colored when prettied up?"
                },
                "org.updateInterval": {
                    "type": "integer",
                    "default": 10000,
                    "description": "Interval to update a buffers parsing."
                },
                "org.decorateLinks": {
                    "type": "boolean",
                    "default": true,
                    "description": "Should links be collapsed to pretty format?"
                },
                "org.decorateBullets": {
                    "type": "boolean",
                    "default": true,
                    "description": "Should headings have pretty bullets?"
                },
                "org.addLeftZero": {
                    "type": "boolean",
                    "default": false,
                    "description": "Add left zero to single-digit dates and months."
                },
                "org.clockInOutSeparator": {
                    "type": "string",
                    "default": "--",
                    "description": "Clock in and clock out separator"
                },
                "org.clockTotalSeparator": {
                    "type": "string",
                    "default": " =>  ",
                    "description": "Clock total separator"
                },
                "org.orgsConnection": {
                    "type": "string",
                    "default": "https://localhost:443",
                    "description": "orgs server connection"
                },
                "org.allowSelfSigned": {
                    "type": "boolean",
                    "default": false,
                    "description": "Allow self signed https certificates on your org server, this is NOT safe"
                }
            }
        },
        "snippets": [
            {
                "language": "org",
                "path": "./snippets/org.json"
            }
        ],
        "keybindings": [
            {
                "command": "org.insertHeadingRespectContent",
                "key": "ctrl+alt+o h",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.insertSubheading",
                "key": "ctrl+alt+o s",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.doDemote",
                "key": "ctrl+alt+o shift+d",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.doPromote",
                "key": "ctrl+alt+o shift+p",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.promoteSubtree",
                "key": "ctrl+alt+o p",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.demoteSubtree",
                "key": "ctrl+alt+o d",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.timestamp",
                "key": "ctrl+alt+o t",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.clockin",
                "key": "ctrl+alt+o ctrl+i",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.clockout",
                "key": "ctrl+alt+o ctrl+o",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.updateclock",
                "key": "ctrl+alt+o ctrl+u",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.incrementContext",
                "key": "alt+right",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.decrementContext",
                "key": "alt+left",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.bold",
                "key": "ctrl+alt+o b",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.italic",
                "key": "ctrl+alt+o i",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.underline",
                "key": "ctrl+alt+o u",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.code",
                "key": "ctrl+alt+o c",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.verbose",
                "key": "ctrl+alt+o v",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.literal",
                "key": "ctrl+alt+o l",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.addDoWhatIMean",
                "key": "ctrl+enter",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.toggleDoWhatIMean",
                "key": "ctrl+o a t",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.tabHandler",
                "key": "ctrl+tab",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "workbench.action.closeActiveEditor",
                "key": "escape",
                "when": "editorTextFocus && editorLangId == 'calendar'"
            },
            {
                "command": "org.capture.close",
                "key": "ctrl+alt+w",
                "when": "hasOrgCapFocus"
            },
            {
                "command": "org.capture.escape",
                "key": "ctrl+alt+q",
                "when": "hasOrgCapFocus"
            },
            {
                "command": "org.calendar.prevDate",
                "key": ",",
                "when": "hasOrgCalFocus"
            },
            {
                "command": "org.calendar.nextDate",
                "key": ".",
                "when": "hasOrgCalFocus"
            },
            {
                "command": "org.calendar.prevWeek",
                "key": "<",
                "when": "hasOrgCalFocus"
            },
            {
                "command": "org.calendar.nextWeek",
                "key": ">",
                "when": "hasOrgCalFocus"
            },
            {
                "command": "org.calendar.setDate",
                "key": "enter",
                "when": "hasOrgCalFocus"
            },
            {
                "command": "org.todo.goto",
                "key": "enter",
                "when": "editorLangId == todolist"
            },
            {
                "command": "org.todo.filter",
                "key": "f3",
                "when": "editorLangId == todolist"
            },
            {
                "command": "org.todo.effort",
                "key": "e",
                "when": "editorLangId == todolist"
            },
            {
                "command": "org.formatUnderCursor",
                "key": "ctrl+q ctrl+f",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.clearCell",
                "key": "ctrl+q space",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.tableModeOn",
                "key": "ctrl+q ctrl+q",
                "when": "editorFocus && !orgTableMode"
            },
            {
                "command": "org.tableModeOff",
                "key": "ctrl+q ctrl+q",
                "when": "editorFocus && orgTableMode"
            },
            {
                "command": "org.gotoNextCell",
                "key": "tab",
                "when": "orgTableMode"
            },
            {
                "command": "org.gotoPreviousCell",
                "key": "shift+tab",
                "when": "orgTableMode"
            },
            {
                "command": "org.moveRowUp",
                "key": "alt+up",
                "when": "orgTableMode"
            },
            {
                "command": "org.moveRowDown",
                "key": "alt+down",
                "when": "orgTableMode"
            },
            {
                "command": "org.moveColRight",
                "key": "alt+right",
                "when": "orgTableMode"
            },
            {
                "command": "org.moveColLeft",
                "key": "alt+left",
                "when": "orgTableMode"
            },
            {
                "command": "org.nextRow",
                "key": "enter",
                "when": "orgTableMode"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "tsc -p ./",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "tslint 'src/**/*.ts'",
        "postinstall": "node ./node_modules/vscode/bin/install",
        "test": "npm run compile && node ./node_modules/vscode/bin/test",
        "generate-syntax": "node syntaxes/populate-syntax.js"
    },
    "devDependencies": {
        "@types/mocha": "^2.2.48",
        "@types/node": "^6.14.13",
        "codecov": "^3.1.0",
        "mocha": "^6.2.3",
        "tslint": "^5.14.0",
        "tslint-config-prettier": "^1.18.0",
        "typescript": "^3.9.10",
        "vscode": "^1.1.x",
        "vscode-coverage-test-runner": "^1.0.0"
    },
    "dependencies": {
        "@types/got": "^9.6.12",
        "@vscode/vsce": "^2.19.0",
        "date-fns": "^1.28.3",
        "isomorphic-ws": "^5.0.0",
        "node-fetch": "^2.6.12",
        "p-event": "^4.2.0",
        "rpc-websocket-client": "^1.1.4",
        "rpc-websockets": "^7.5.0",
        "ws": "^8.10.0"
    }
}
